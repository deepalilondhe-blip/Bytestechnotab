# MIS Admin WordPress Credentials
WP_ADMIN_URL=https://mis-admin-url-here.com/wp-login.php
WP_USERNAME="your-mis-wordpress-username"
WP_PASSWORD="your-mis-wordpress-password"

# HTTP Basic Auth Credentials (leave blank if not used by MIS site)
HTTP_BASIC_AUTH_USER=""
HTTP_BASIC_AUTH_PASS=""

# Frontend Verification URL for MIS
FRONTEND_URL=https://mis-site-url-here.com/your-target-page

# Path to the source content file
WORD_FILE_PATH=./content.md

# Set to false to launch a new headed Chrome window, true to connect to debug Chrome on port 9222
USE_CDP=false
